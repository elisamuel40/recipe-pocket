{
  "name": "recipe-pocket",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-only Chrome extension for reading and managing recipes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && node scripts/audit-dist.mjs",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
